[supervisord]
nodaemon = true
pidfile = /app/var/run/supervisord.pid

; With nodaemon the log already goes to the container's output. Writing it to a
; file as well duplicated every line and put it under two rotators at once --
; supervisor's own 50 MB x 10, and logrotate, which matches /app/var/log/*.log.
logfile = /dev/null
logfile_maxbytes = 0

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

{{- if ne .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_ENABLED "false" }}

[supervisorctl]
serverurl = unix://{{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_PATH }}

{{- if ne .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_AUTH_ENABLED "false" }}
username = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_USERNAME }}
password = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_PASSWORD }}
{{ end }}

[unix_http_server]
file = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_PATH }}
chmod = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_CHMOD }}
# chown = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_CHOWN }}

{{- if ne .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_AUTH_ENABLED "false" }}
username = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_USERNAME }}
password = {{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_PASSWORD }}
{{ end }}

{{- end -}}

{{- if ne .Env.SUPERVISOR_XMLRPC_INET_ENABLED "false" }}

[inet_http_server]
port = {{ .Env.SUPERVISOR_XMLRPC_INET_HOST }}:{{ .Env.SUPERVISOR_XMLRPC_INET_PORT }}
username = {{ .Env.SUPERVISOR_XMLRPC_INET_USERNAME }}
password = {{ .Env.SUPERVISOR_XMLRPC_INET_PASSWORD }}

{{- end }}

[include]
files = /opt/etc/supervisor.d/*.ini