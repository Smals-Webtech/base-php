LoadModule ssl_module modules/mod_ssl.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so

SSLRandomSeed startup file:/dev/urandom 512
SSLRandomSeed connect builtin

SSLCipherSuite {{ .Env.APACHE_SSL_CIPHER_SUITE }}
SSLProxyCipherSuite {{ .Env.APACHE_SSL_CIPHER_SUITE }}

SSLHonorCipherOrder on

SSLProtocol {{ .Env.APACHE_SSL_PROTOCOL }}
SSLProxyProtocol {{ .Env.APACHE_SSL_PROTOCOL }}

SSLPassPhraseDialog  builtin

SSLSessionCache        "shmcb:/app/var/cache/apache2/mod_ssl/scache(512000)"
SSLSessionCacheTimeout  300
