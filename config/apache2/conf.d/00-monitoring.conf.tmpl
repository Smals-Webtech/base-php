# Monitoring endpoints, on their own port.
#
# They used to sit in the application vhost, on the port a Route or a Service
# publishes. The CIDR allow-list below could not protect them there: behind a
# router, the address apache sees is the router's, which is private and so
# passes the check -- every request from the internet did too. Serving them on a
# port nothing publishes is what actually keeps them internal; the allow-list
# stays as a second line, for a deployment that does publish this port.
#
# A sidecar in the same pod shares the network namespace and reaches these over
# localhost. apache cannot listen on a unix socket, so the socket half of the
# nginx monitoring server has no equivalent here.

<VirtualHost *:{{ .Env.APACHE_MONITORING_LISTEN }}>

    ServerName {{ .Env.APACHE_SERVER_NAME }}

    # An empty root of its own, so this port serves its endpoints and nothing
    # else. Inheriting the server-level DocumentRoot would hand out the
    # application's files here -- the very defect this change is about, one level
    # down. Anything that matches no Location below finds no file and gets a 404.
    #
    # A `<Location /> Require all denied` catch-all does NOT work for this:
    # AuthzMergeRules defaults to On, so the deny merges with the endpoints' own
    # Require rules instead of being overridden by them, and every request --
    # including the legitimate ones -- comes back 403.
    DocumentRoot {{ .Env.APACHE_MONITORING_DOCUMENT_ROOT }}

    # Granting the empty root is what turns an unmatched path into a 404 rather
    # than a 403, which is what the nginx monitoring server answers and what the
    # documentation promises. There is nothing to serve here: the directory is
    # empty and Options -Indexes applies server-wide.
    <Directory {{ .Env.APACHE_MONITORING_DOCUMENT_ROOT }}>
        Require all granted
    </Directory>

    Alias /real-time-status "/usr/local/php/php/fpm/status.html"
    <Directory /usr/local/php/php/fpm >
        Require local
{{- if .Env.MONITORING_ALLOW }}
        Require ip {{ .Env.MONITORING_ALLOW }}
{{- end }}
    </Directory>

    <Location /status >
        SetHandler "proxy:unix:/app/var/run/php-fpm/php-fpm.sock|fcgi://localhost"
        Require local
{{- if .Env.MONITORING_ALLOW }}
        Require ip {{ .Env.MONITORING_ALLOW }}
{{- end }}
    </Location>

    <IfModule status_module>
    <Location /server-status >
        SetHandler server-status
        Require local
{{- if .Env.MONITORING_ALLOW }}
        Require ip {{ .Env.MONITORING_ALLOW }}
{{- end }}
    </Location>
    </IfModule>

    ErrorLog {{ .Env.APACHE_DEFAULT_VHOST_ERROR_LOG_TARGET }}
    CustomLog {{ .Env.APACHE_DEFAULT_VHOST_CUSTOM_LOG_TARGET }} combined

</VirtualHost>
