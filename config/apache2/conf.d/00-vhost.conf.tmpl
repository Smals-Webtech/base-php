<VirtualHost *:{{.Env.APACHE_LISTEN}}>

    ServerName default.localhost

    LimitRequestLine 16384

    # Uncomment the following line to force Apache to pass the Authorization
    # header to PHP: required for "basic_auth" under PHP-FPM and FastCGI
    #
    # SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1

    # For Apache 2.4.9 or higher
    # Using SetHandler avoids issues with using ProxyPassMatch in combination
    # with mod_rewrite or mod_autoindex
    <FilesMatch \.php$>
        SetHandler "proxy:unix:/app/var/run/php-fpm/php-fpm.sock|fcgi://localhost"
    </FilesMatch>

    DocumentRoot /app/var/www/html

    # The status endpoints are served by 00-monitoring.conf on their own port.
    # They used to live here, on the port a route publishes, where the CIDR
    # allow-list could not distinguish the router from the internet behind it.
    # /server-info is gone with them: mod_info is not loaded, so it only ever
    # answered 404 while suggesting an endpoint existed.

    ErrorLog {{.Env.APACHE_DEFAULT_VHOST_ERROR_LOG_TARGET}}
    CustomLog {{.Env.APACHE_DEFAULT_VHOST_CUSTOM_LOG_TARGET}} combined

</VirtualHost>
