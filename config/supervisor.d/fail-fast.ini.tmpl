[eventlistener:fail-fast]
command=/usr/local/bin/supervisord-fail-fast.py {{ .Env.SUPERVISOR_FAIL_FAST_PROGRAMS }}
events=PROCESS_STATE_EXITED,PROCESS_STATE_FATAL

{{- if ne .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_AUTH_ENABLED "false" }}
; supervisor hands every listener SUPERVISOR_SERVER_URL but no credentials, and
; its own childutils reads them from these two names. Without them the shutdown
; call comes back 401 and the listener is a no-op.
environment=SUPERVISOR_USERNAME="{{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_USERNAME }}",SUPERVISOR_PASSWORD="{{ .Env.SUPERVISOR_XMLRPC_UNIX_SOCKET_PASSWORD }}"
{{- end }}

; The listener is the safety net for the programs above; if it went away
; quietly, a later crash would go back to leaving the container up with orphaned
; workers still serving. Keep it running.
autorestart=true

stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
