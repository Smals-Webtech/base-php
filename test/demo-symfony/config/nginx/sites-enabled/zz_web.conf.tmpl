server {

  listen       9000;
  server_name  demo.localhost;

  index index.php;

  root /app/public ;

  location / {
    # try to serve file directly, fallback to index.php
    try_files $uri /index.php$is_args$args;
  }

  location ~ ^/index\.php(/|$) {
    fastcgi_pass unix:/app/var/run/php-fpm/php-fpm.sock;
    fastcgi_split_path_info ^(.+\.php)(/.+)$;
    include fastcgi_params;

    fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
    fastcgi_param DOCUMENT_ROOT $realpath_root;

    # Propagate the request id + traffic class to php-fpm so its access.format
    # (PHP_FPM_ACCESS_FORMAT) emits the SAME rid → nginx and php-fpm logfmt lines
    # correlate in Loki. $traffic_class map lives in the 00_logfmt.conf overlay.
    fastcgi_param UNIQUE_ID     $request_id;
    fastcgi_param traffic_class $traffic_class;

    internal;

  }

  location ~ \.php$ {
      return 404;
  }

  more_set_headers "Test-Engine: bats";

}
