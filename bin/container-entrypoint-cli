#!/usr/bin/env bash
set -eo pipefail

umask 002

export DEBUG=${DEBUG:-false}

# DEBUG raises log levels. It used to switch on `set -x` as well, and the trace
# printed every value the entrypoint handles -- the AWS keys, every password --
# into the container log, which is collected and kept. The trace is a switch of
# its own now, for a diagnosis on a workstation; it still prints those values.
if [[ "${DEBUG_XTRACE:-false}" == "true" ]]; then
	echo "[WARN] DEBUG_XTRACE=true: the startup trace prints every value, secrets included. Never in production." >&2
	set -x
fi

source /usr/local/bin/container-entrypoint.d/entrypoint.d/00-functions.sh
source /usr/local/bin/container-entrypoint.d/entrypoint.d/01-php.sh
source /usr/local/bin/container-entrypoint.d/entrypoint.d/60-aws-config.sh
# A child image's early hooks (/opt/bin/container-entrypoint.d/entrypoint.d),
# at the point the web entrypoint loads them too: after the image's own
# defaults, before unknown PHP_* variables are reported and the defaults are
# resolved. Without it a <VARIABLE>_WCMTECH_DEFAULT set by a cli child did
# nothing, and cli children took to sourcing this image's scripts themselves.
source /usr/local/bin/container-entrypoint.d/entrypoint.d/90-app.sh
source /usr/local/bin/container-entrypoint.d/entrypoint.d/98-unknown-vars.sh
source /usr/local/bin/container-entrypoint.d/entrypoint.d/99-export-vars.sh

# The cli variant runs no supervisor, so it renders no script into /opt/sbin
# and keeps no runtime state under /app/var. Requiring either would make a
# read-only cli container mount paths it never writes.
require-writable /opt/etc
require-writable /app/tmp

print-banner

log "INFO" "+---- Configure PHP Container -----"

source /usr/local/bin/container-entrypoint.d/base.d/01-php.sh
# The AWS CLI ships in every variant, and a cli container is the likeliest place
# to run it. Without these two the variant had no rendered configuration and no
# wrapper -- and, because nothing registered the variables for cleanup, the raw
# AWS_* reached the process, the opposite of the policy the web variants apply.
source /usr/local/bin/container-entrypoint.d/base.d/60-aws-config.sh
source /usr/local/bin/container-entrypoint.d/base.d/99-cleanup-vars.sh

log "INFO" "+---- PHP Container configured successfully -----"

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
	set -- php "$@"
fi

exec "$@"
