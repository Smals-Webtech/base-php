#!/usr/bin/env bash
#
# Writes /usr/local/share/base-php/ini-directives.list: every php.ini directive
# this image can be asked about. It is what makes a directive overridable *and*
# cleaned: entrypoint.d/01-php.sh declares one <NAME>_WCMTECH_DEFAULT per entry,
# and 99-export-vars.sh registers each promoted name for the cleanup that runs
# before the application starts. A name missing from the list is neither.
#
# The image runs it once at build. A child image that installs an extension of
# its own runs it again, as root, after the install -- otherwise the extension's
# directives are unknown to the entrypoint: setting them does nothing, and the
# variable reaches the application.
#
# Generated at build so the boot pays nothing: one `mapfile` instead of a `php`
# process. PHP_INI_SCAN_DIR is named explicitly rather than inherited -- it must
# be the image's own conf.d, so that every installed extension is loaded and its
# directives enumerated, and never /opt/etc, which is render output (#69).
#
# ini_get_all() only knows the SAPI that runs it, and a directive it misses is
# neither configurable nor cleaned. The ones FPM declares and the CLI does not
# are appended here -- fastcgi.logging, which this image forces, among them.
#
# The list is the union across the PHP versions this image tracks, so two of them
# are inert on one of the branches: cgi.force_redirect and cgi.redirect_status_env
# exist under FPM on 8.4 and were removed in 8.5. A name PHP does not know costs
# an empty variable that is declared and cleaned, which is the safe direction.
# The same reasoning keeps the names of an existing list: a rerun only ever adds.
#
# tests.web.bats re-derives the FPM difference against a live php-fpm rather than
# trusting this list, and that assertion is what caught those two -- a
# measurement taken on 8.5 alone had called them dead.

set -euo pipefail

LIST=/usr/local/share/base-php/ini-directives.list

NAMES="$(mktemp)"
trap 'rm -f "$NAMES"' EXIT

# A php that fails to enumerate must fail the build, not ship a short list: under
# set -e the script stops here, before the list is rewritten.
# shellcheck disable=SC2016  # PHP code: $name is PHP's, not the shell's
PHP_INI_SCAN_DIR=/usr/local/etc/php/conf.d \
	php -r 'foreach (array_keys(ini_get_all(null, false)) as $name) { echo $name, PHP_EOL; }' >"$NAMES"

printf '%s\n' cgi.discard_path cgi.fix_pathinfo cgi.force_redirect cgi.nph \
	cgi.redirect_status_env cgi.rfc2616_headers fastcgi.error_header \
	fastcgi.logging fastcgi.script_path_encoded fpm.config >>"$NAMES"

if [ -f "$LIST" ]; then
	cat "$LIST" >>"$NAMES"
fi

mkdir -p "${LIST%/*}"
LC_ALL=C sort -u "$NAMES" >"$LIST"
test -s "$LIST"

echo "${LIST}: $(wc -l <"$LIST") directives"
